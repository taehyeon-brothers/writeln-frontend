    "/api/v1/matches": {
      "post": {
        "tags": ["match-controller"],
        "summary": "매칭 API",
        "description": "요청한 사용자와 일상의 결이 맞는 최대 3명의 사용자를 매칭해줍니다",
        "operationId": "match",
        "responses": {
          "4xx": {
            "description": "네트워크 관련 예외 발생",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "4xx or 5xx": {
            "description": "데이터베이스 관련 예외 발생",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "5xx": {
            "description": "서버 내부 오류",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "200": {
            "description": "성공적으로 매칭됨",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/MatchResponse" }
              }
            }
          }
        },
        "security": [{ "JWT": [] }]
      }
    },
