  "components": {
    "schemas": {
      "ErrorResponse": {
        "required": ["code", "errors", "message", "path", "timestamp"],
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "에러 발생 시간",
            "format": "date-time"
          },
          "code": { "type": "string", "description": "에러 코드" },
          "message": { "type": "string", "description": "에러 메시지" },
          "path": {
            "type": "string",
            "description": "에러가 발생한 요청 경로"
          },
          "errors": {
            "type": "array",
            "description": "필드 에러 목록",
            "items": { "$ref": "#/components/schemas/FieldError" }
          }
        },
        "description": "에러 응답 객체"
      },
      "FieldError": {
        "required": ["field", "reason"],
        "type": "object",
        "properties": {
          "field": { "type": "string", "description": "에러가 발생한 필드명" },
          "value": {
            "type": "object",
            "description": "에러가 발생한 필드의 값"
          },
          "reason": { "type": "string", "description": "에러 이유" }
        },
        "description": "필드 에러 정보"
      },
      "MatchResponse": {
        "required": ["matchedUserIds", "matchedUsersWithTags"],
        "type": "object",
        "properties": {
          "matchedUserIds": {
            "type": "array",
            "description": "매칭된 유저 ID 리스트",
            "example": [11, 50, 100],
            "items": {
              "type": "integer",
              "description": "매칭된 유저 ID 리스트",
              "format": "int64"
            }
          },
          "matchedUsersWithTags": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "description": "매칭된 유저 ID와 태그 목록",
              "example": { "11": ["태그1", "태그2"], "50": ["태그3", "태그4"] },
              "items": {
                "type": "string",
                "description": "매칭된 유저 ID와 태그 목록",
                "example": "{\"11\":[\"태그1\",\"태그2\"],\"50\":[\"태그3\",\"태그4\"]}"
              }
            },
            "description": "매칭된 유저 ID와 태그 목록",
            "example": { "11": ["태그1", "태그2"], "50": ["태그3", "태그4"] }
          }
        }
      },
      "RefreshTokenRequest": {
        "required": ["refreshToken"],
        "type": "object",
        "properties": { "refreshToken": { "type": "string" } }
      },
      "TokenResponse": {
        "required": ["accessToken", "refreshToken"],
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" }
        }
      },
      "AuthorizationCodeRequest": {
        "required": ["code", "redirectUri"],
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "redirectUri": { "type": "string" }
        }
      },
      "DailyUploadResponse": {
        "required": ["dailyId"],
        "type": "object",
        "properties": { "dailyId": { "type": "integer", "format": "int64" } }
      },
      "TagAddRequest": {
        "required": ["tagName"],
        "type": "object",
        "properties": { "tagName": { "type": "string" } }
      },
      "TagDetailResponse": {
        "required": ["tagId", "tagName"],
        "type": "object",
        "properties": {
          "tagId": { "type": "integer", "format": "int64" },
          "tagName": { "type": "string" }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
